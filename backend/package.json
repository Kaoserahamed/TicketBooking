{
  "name": "ticket-booking-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express.js API for the Ticket Booking System (see docs/02-system-architecture.md)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:check": "node scripts/test-connection.js",
    "db:migrate": "node scripts/run-migrations.js",
    "seed:passwords": "node scripts/set-seed-passwords.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/",
    "test:unit": "node --test tests/unit/",
    "test:integration": "node --test tests/integration/",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ticket-booking",
    "express",
    "mysql"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@sentry/node": "^9.47.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.0.10",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^26.6.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.0.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
