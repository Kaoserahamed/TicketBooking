# =============================================
# Ticket Booking System - backend test template
# ---------------------------------------------
# Points the backend suites at the throwaway stack defined in
# docker-compose.test.yml (MySQL on 3307, Redis on 6380). Copy it to
# `backend/.env`, which takes precedence over the repository-root `.env`:
#
#   docker compose -f docker-compose.test.yml up -d
#   Copy-Item backend/.env.test.example backend/.env   # PowerShell
#   # cp backend/.env.test.example backend/.env        # bash
#   cd backend; npm test
#
# `backend/.env` is git-ignored - never commit real credentials.
# =============================================

NODE_ENV=test

# ---- MySQL (docker-compose.test.yml) ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=tbs_test
DB_PASSWORD=test-db-password
DB_NAME=ticket_booking_test
DB_CONNECTION_LIMIT=10

# ---- Redis (docker-compose.test.yml) ----
REDIS_URL=redis://localhost:6380
REDIS_CONNECT_TIMEOUT_MS=2000

# ---- Auth (test-only values; placeholders are only rejected in production) ----
JWT_SECRET=test-only-access-secret-not-for-production
JWT_REFRESH_SECRET=test-only-refresh-secret-not-for-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ticket-booking-api

# ---- Email (never leaves the process during tests) ----
MAIL_TRANSPORT=console
MAIL_FROM=Ticket Booking <no-reply@ticketbooking.local>

# ---- Observability (silent is the default under NODE_ENV=test) ----
LOG_LEVEL=silent
