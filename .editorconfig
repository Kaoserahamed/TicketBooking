# EditorConfig for the Ticket Booking System monorepo.
#
# The per-stack `.prettierrc.json` files own the JavaScript/TypeScript
# formatting; this file is the source of truth for everything else (docs,
# YAML, JSON), mirrored by the root `.prettierrc.json`.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
