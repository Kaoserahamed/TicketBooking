# =============================================
# Ticket Booking System - environment template
# Copy this file to .env and fill in real values:
#   PowerShell:  Copy-Item .env.example .env
# .env is git-ignored - never commit real secrets.
# =============================================

# ---- API server ----
NODE_ENV=development
PORT=4000

# ---- MySQL Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ticket_booking
DB_CONNECTION_LIMIT=10

# MySQL password (legacy format reference)
MY_SQL_PASSWORD=your_password

# ---- Redis ----
REDIS_URL=redis://localhost:6379
# How long to wait for the initial Redis handshake before falling back to the
# in-process cache/rate-limit store (milliseconds).
REDIS_CONNECT_TIMEOUT_MS=2000

# ---- Auth ----
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ticket-booking-api

# bcrypt cost factor (10 is a good default; higher = slower but stronger)
BCRYPT_ROUNDS=10

# Rate limiting for /api/v1/auth/* (per IP)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Refresh-token cookie (httpOnly, SameSite)
REFRESH_COOKIE_NAME=tb_refresh_token
# Refresh-token cookie lifetime in milliseconds (default 7 days)
REFRESH_COOKIE_MAX_AGE_MS=604800000
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ---- Email / verification / password reset ----
# MAIL_TRANSPORT: console (log only, default when no SMTP_HOST) or smtp
MAIL_TRANSPORT=console
MAIL_FROM=Ticket Booking <no-reply@ticketbooking.local>
# Link base used inside verification / reset emails (the frontend origin)
APP_BASE_URL=http://localhost:5173
# New accounts must verify their email before they can sign in (true/false)
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# ---- Payment ----
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=your_stripe_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# ---- Email / SMS ----
SMTP_HOST=smtp.your-provider.com
# 587 + STARTTLS in most providers; set SMTP_SECURE=true for implicit TLS (465)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMS_PROVIDER=twilio

# ---- Seed data (backend/scripts/set-seed-passwords.js) ----
# Password given to the demo accounts created by tests/sql/01-seed-data.sql
SEED_PASSWORD=ChangeMe123!

# ---- Observability ----
# Structured log level: trace|debug|info|warn|error|fatal|silent
# (silent is the default under NODE_ENV=test)
LOG_LEVEL=info
# Name reported as the `service` label on every log line and Prometheus metric
SERVICE_NAME=ticket-booking-api
# Prometheus scrape endpoint: set METRICS_ENABLED=false to disable /metrics
METRICS_ENABLED=true
# When set, GET /metrics requires `Authorization: Bearer <METRICS_TOKEN>`
METRICS_TOKEN=
# Optional Sentry DSN - leave empty to keep the API self-contained (no error tracking)
SENTRY_DSN=
# Fraction of transactions sent to Sentry for performance tracing (0 disables)
SENTRY_TRACES_SAMPLE_RATE=0.1
