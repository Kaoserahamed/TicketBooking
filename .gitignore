# Dependencies
node_modules/

# Environment / secrets
# Copy .env.example to .env - real credentials must never be committed
# (see docs/11-security.md - "Secrets management").
.env
.env.local
.env.*.local

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*

# Test / coverage output
coverage/

# Editor / OS
.idea/
.DS_Store
Thumbs.db

# Terraform — state, plans and provider caches are machine-local
# (remote state lives in S3 + DynamoDB, see docs/deployment/production.md).
# `.terraform.lock.hcl` is NOT ignored: like package-lock.json it is committed
# so provider versions are reproducible.
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
crash.log
